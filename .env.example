AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Opcional. Para GPT-5 mini o nano: minimal. Dejar vacío si el modelo no admite razonamiento.
AZURE_OPENAI_REASONING_EFFORT=minimal
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COACH_REQUESTS_PER_MINUTE=12
COACH_MAX_CONCURRENT=2
COACH_MAX_OUTPUT_TOKENS=900
COACH_TIMEOUT_MS=20000

# Presupuesto estimado del asistente (tarifas por millón de tokens, en USD)
MAGIC_MONTHLY_LIMIT_EUR=2
MAGIC_INPUT_USD_PER_MILLION=0.25
MAGIC_CACHED_INPUT_USD_PER_MILLION=0.025
MAGIC_OUTPUT_USD_PER_MILLION=2
# Dólares por euro: revisa esta cifra y las tarifas en Azure.
MAGIC_USD_PER_EUR=1.099
# 1 sin impuestos adicionales; ajusta si corresponde.
MAGIC_COST_MULTIPLIER=1
MAGIC_TIMEZONE=Europe/Madrid
MAGIC_DB_PATH=./data/magic.sqlite
